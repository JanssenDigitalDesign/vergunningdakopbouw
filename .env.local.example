# Copy this file to .env.local and fill in the values from your Supabase
# project (Project Settings -> API). Also add the same three variables in
# Vercel: Project Settings -> Environment Variables.

# Project URL, e.g. https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# "anon" / "public" key — safe to expose to the browser, only used to read
# the public landing_pages content.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# "service_role" key — SECRET, server-only. Used by /api/contact to write
# leads. Never prefix this with NEXT_PUBLIC_ and never commit it.
SUPABASE_SERVICE_ROLE_KEY=
